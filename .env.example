# LeadPulse AI - Environment Configuration
NODE_ENV=development
PORT=3000

# Turso Cloud Database (LibSQL)
# For local testing without Turso cloud, you can use: file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# JWT Secrets & Security
JWT_SECRET=super_secret_jwt_key_leadpulse_ai_change_in_production
JWT_EXPIRES_IN=7d

# AI Providers (Google Gemini & OpenAI)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Settings
CORS_ORIGIN=*
